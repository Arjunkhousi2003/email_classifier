# Copy to .env and replace every placeholder before running outside local demo mode.
DEV_MODE=true
# Supabase → Project Settings → Database → Connection string → Session pooler (port 5432).
# Paste the URI as shown. The app adds the psycopg2 driver and sslmode=require.
# URL-encode any @ # / or % characters in the database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
RETENTION_DAYS=365
FETCH_INTERVAL_SECONDS=300
MODEL_PATH=models/classifier.joblib
